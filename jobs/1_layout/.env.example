# Copy to .env in this folder. Used when the runner starts the Modal
# launcher image (Dockerfile.modal); a local `uvx modal run` uses your
# ~/.modal.toml instead.

# Modal API token (modal.com -> Settings -> API Tokens).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Only for running run.py directly (CPU, or against your own inference
# server); gpu_job.py sets both for the Modal run.
# Page render DPI for the layout model (default 192; Surya reads ~150 DPI).
# LAYOUT_RENDER_DPI=
# Pages on the model at once: the inference server's parallel slots (default 1).
# SURYA_INFERENCE_PARALLEL=
