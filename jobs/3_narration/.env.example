# Copy to .env in this folder (gitignored, never commit real keys). Read
# by run.py itself for local runs, and passed to the container by the
# runner (docker run --env-file).

# Google AI Studio key.
# Get one at https://aistudio.google.com/apikey -- free tier, no credit
# card needed.
GEMINI_API_KEY=

# Narration style, for trying one out -- see the TONES dict in stages.py
# for the full list and what each one means. Optional; overrides the
# paper's own tone (narration_tone in config/papers.toml), which
# defaults to "colloquial". Only the page step uses it, so the cached
# article summaries are reused.
NARRATION_TONE=
