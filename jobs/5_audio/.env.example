# Copy to .env in this folder (gitignored, never commit real keys). Read
# by run.py itself for local runs, and passed to the container by the
# runner (docker run --env-file).

# Google AI Studio key, for the TTS Batch API.
GEMINI_API_KEY=

# Which speech engine renders: "gemini" (the default) or "qwen3-tts" (on
# Modal's GPUs, see qwen3_tts.py).
SPEECH_ENGINE=gemini

# Modal, for qwen3-tts (https://modal.com/settings/tokens). A local
# run can use ~/.modal.toml (`uvx modal token new`) instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
